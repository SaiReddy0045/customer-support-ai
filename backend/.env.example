APP_ENV=development
API_PORT=8000
ABC_AUTH_SECRET=replace-with-a-long-random-development-secret
DATABASE_URL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_SECONDS=12
OLLAMA_HEALTH_TIMEOUT_SECONDS=2
OLLAMA_NUM_PREDICT=192
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
CORS_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1):\d+
CANCELLATION_WINDOW_HOURS=24
REFUND_WINDOW_HOURS=12
TRACKING_CONFIRMED_MINUTES=30
TRACKING_PACKING_HOURS=24
TRACKING_SHIPPED_HOURS=36
TRACKING_NEAR_LOCATION_HOURS=48